{
  "mcpServers": {
    "trial-ledger": {
      "command": "uv",
      "args": [
        "run", "--directory", "/path/to/trial-ledger", "--extra", "mcp",
        "trial-ledger-mcp",
        "--data", "/path/to/prices.csv",
        "--ledger", "/path/to/your/project/.trial-ledger",
        "--holdout-from", "2024-01-01",
        "--agent", "claude-code"
      ]
    }
  }
}
